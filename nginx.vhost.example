# AgeCMS on nginx + PHP-FPM. Copy to /etc/nginx/sites-available/, adjust server_name, root and the FPM socket.
# Shadow cache: for a plain GET (no query string, no admin cookie) nginx looks for assets/cache/<slug>.html
# first and answers from disk in about a millisecond. PHP only runs on a cache miss, for forms, admin and API.
#
# Security headers: PHP sends them for every answer it makes (core/security-headers.php, and for public pages the sites of the
# setting security.frame_ancestors, see core/Embedding.php), so nginx adds them ONLY where it answers without PHP (cache files,
# uploads, assets, the admin JSON endpoints) and never at server level, where they would be added to PHP's answers as a second copy.
# A request that comes from a frame (the browser says Sec-Fetch-Dest: iframe) skips the disk cache and goes to PHP, because only PHP
# knows which sites may frame the page; ordinary visits keep the disk speed.

map $http_cookie $agecms_admin {
    default 0;
    "~*(^|;\s*)agecms_admin=" 1;
}
# $is_args is "?" when there is a query string, so the key below means: GET, no query, not admin, not from a frame.
map $http_sec_fetch_dest $agecms_framed {
    default  0;
    iframe   1;
    frame    1;
}
map "$request_method:$is_args:$agecms_admin:$agecms_framed" $agecms_cache_dir {
    default      /assets/cache-off;
    "GET::0:0"   /assets/cache;
    "HEAD::0:0"  /assets/cache;
}

# Speed for phones (Core Web Vitals): HTTP/3 and compression. With TLS (certbot) the server block listens on 443; add
#   listen 443 quic reuseport;  http3 on;  add_header Alt-Svc 'h3=":443"; ma=86400' always;
# and in http {} (or here): gzip on; gzip_types text/css application/javascript image/svg+xml application/json; (brotli too, if the module is installed).
# A CDN in front of the site (for Russia: Yandex Cloud CDN, Selectel, Cloud.ru) gives HTTP/3 and edge caching without touching the server.
server {
    listen 80;
    server_name example.com;
    root /var/www/agecms;
    index index.php;
    charset utf-8;
    client_max_body_size 12m;

    # No add_header at server level: see the note at the top. PHP sends the security headers of its own answers.

    # Internals are never served.
    location ~ ^/(data|core|bin|tests|bench|docs|modules|tools)(/|$) { return 404; }
    location ~ ^/(LICENSE|README\.md|CONTRIBUTING\.md|ROADMAP\.md|HOSTER_INTEGRATION_WHITEPAPER\.md|AGENTS\.md|install\.sh|nginx\.vhost\.example)$ { return 404; }
    location ~ /\.(?!well-known/) { return 404; }

    # Cache files are reachable only through the internal try_files redirect below.
    location ^~ /assets/cache/ {
        internal;
        default_type text/html;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
        add_header X-AgeCMS-Cache "hit" always;
        # Cache files are answered by nginx without PHP, with the strict headers (a request from a frame never gets here, see $agecms_framed).
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self' https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-src 'self' https://yandex.ru/map-widget/ https://yandex.com/map-widget/ https://www.google.com/maps/embed https://www.openstreetmap.org/export/embed.html https://mc.yandex.ru; frame-ancestors 'self'" always;
    }

    # Files of copied pages (CopyPage): a script or a page opened by its address runs under a policy that allows nothing.
    location ^~ /assets/uploads/copy/ {
        location ~ \.php$ { return 404; }
        expires 7d;
        add_header Cache-Control "public" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox" always;
        try_files $uri =404;
    }
    location ^~ /assets/uploads/ {
        location ~ \.php$ { return 404; }
        expires 30d;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }
    location ^~ /assets/ {
        expires 7d;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # The run address of the scheduler carries a secret in its query: it is kept out of the access log.
    location = /_/cron {
        access_log off;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_hide_header X-AgeCMS-Policy;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_read_timeout 60s;
    }
    location = /index { rewrite ^ /index.php last; }
    # Shadow cache hit: an internal redirect into the location above, so the file is sent with its headers.
    # (try_files serves a file in the current location, which would drop Cache-Control and X-AgeCMS-Cache.)
    location = / {
        set $agecms_file $agecms_cache_dir/index.html;
        if (-f $document_root$agecms_file) { rewrite ^ $agecms_file last; }
        try_files /agecms-no-such-file @agecms;
    }
    location / {
        set $agecms_file $agecms_cache_dir$uri.html;
        if (-f $document_root$agecms_file) { rewrite ^ $agecms_file last; }
        try_files $uri @agecms;
    }

    location @agecms {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        # The policy of the answer (strict, a copied page's own, or with the frame sites) comes from PHP and is passed on as it is.
        fastcgi_hide_header X-AgeCMS-Policy;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_hide_header X-AgeCMS-Policy;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }
    # The admin pages send their own security headers (always strict, never framed).
    location ~ ^/admin/(index|install)\.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_read_timeout 30s;
    }
    # The JSON endpoints of the admin send none, so nginx adds the strict set.
    location ~ ^/admin/(api|mcp|upload)\.php$ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self' https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-src 'self' https://yandex.ru/map-widget/ https://yandex.com/map-widget/ https://www.google.com/maps/embed https://www.openstreetmap.org/export/embed.html https://mc.yandex.ru; frame-ancestors 'self'" always;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_read_timeout 30s;
    }
    location = /admin/ { rewrite ^ /admin/index.php last; }
    # No other PHP file is ever executed.
    location ~ \.php$ { return 404; }
}
