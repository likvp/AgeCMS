# AgeCMS routing for Apache (mod_rewrite, mod_headers). Install in the document root.
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
    # Security headers. PHP sends its own for every answer it makes (core/security-headers.php; for public pages also the sites of
    # the setting security.frame_ancestors, core/Embedding.php; a copied page has its own policy, CopyPage::csp). Apache adds the
    # strict set only to answers without PHP's policy: cache files, uploads, assets, the 404s of the rules below. Never replace PHP's
    # copy: a plain "Header always set" would overwrite the frame sites and bring X-Frame-Options back.
    Header always set X-Content-Type-Options "nosniff" "expr=-z %{resp:Content-Security-Policy}"
    Header always set X-Frame-Options "SAMEORIGIN" "expr=-z %{resp:Content-Security-Policy}"
    Header always set Referrer-Policy "strict-origin-when-cross-origin" "expr=-z %{resp:Content-Security-Policy}"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()" "expr=-z %{resp:Content-Security-Policy}"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self' https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-src 'self' https://yandex.ru/map-widget/ https://yandex.com/map-widget/ https://www.google.com/maps/embed https://www.openstreetmap.org/export/embed.html https://mc.yandex.ru; frame-ancestors 'self'" "expr=-z %{resp:Content-Security-Policy}"
    Header always unset X-AgeCMS-Policy
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # PHP behind CGI/FastCGI does not see the Authorization header: pass it on for Bearer tokens (Http::bearer).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 1. Internals are never served.
    RewriteRule ^(data|core|bin|tests|bench|docs|tools)(/|$) - [R=404,L]
    RewriteRule ^modules/ - [R=404,L]
    RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
    RewriteRule ^(composer\.(json|lock)|phpunit\.xml.*)$ - [R=404,L]
    RewriteRule ^(LICENSE|README\.md|CONTRIBUTING\.md|ROADMAP\.md|HOSTER_INTEGRATION_WHITEPAPER\.md|AGENTS\.md|install\.sh|nginx\.vhost\.example)$ - [R=404,L]

    # Only the front controller and the admin entry points run PHP, as in nginx.vhost.example.
    RewriteRule ^(?!index\.php$|admin/(index|api|mcp|install|upload)\.php$).+\.php$ - [R=404,L]

    # Direct requests for cache files are refused, the public URL is the page URL (THE_REQUEST is the client's own line).
    RewriteCond %{THE_REQUEST} \s/assets/cache/
    RewriteRule ^ - [R=404,L]

    # 2. /index is a duplicate of / and is redirected by PHP.
    RewriteRule ^index$ index.php [L]

    # 3. Shadow cache hit: a rendered copy exists, PHP is never started.
    #    Only plain GET and HEAD requests without a query string and without the admin marker cookie. A request from a frame
    #    (Sec-Fetch-Dest: iframe) goes to PHP instead, which knows which sites may frame the page (security.frame_ancestors).
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{QUERY_STRING} ^$
    RewriteCond %{HTTP_COOKIE} !(^|;\s*)agecms_admin=
    RewriteCond %{HTTP:Sec-Fetch-Dest} !^i?frame$
    RewriteCond %{DOCUMENT_ROOT}/assets/cache/$1.html -f
    RewriteRule ^([a-z0-9][a-z0-9_/-]*)$ assets/cache/$1.html [L]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{QUERY_STRING} ^$
    RewriteCond %{HTTP_COOKIE} !(^|;\s*)agecms_admin=
    RewriteCond %{HTTP:Sec-Fetch-Dest} !^i?frame$
    RewriteCond %{DOCUMENT_ROOT}/assets/cache/index.html -f
    RewriteRule ^$ assets/cache/index.html [L]

    # 4. Everything that is not a real file goes to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
